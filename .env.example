# Real AI correction with Claude vision (leave empty to use the keyword grader)
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-sonnet-5-5
PORT=8787
# Database (PostgreSQL). Paste your connection link from Neon, Supabase, or a PostgreSQL on your PC, e.g.
#   DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/enticra?sslmode=require
# Leave it empty to use the built-in PostgreSQL, which keeps its files in DATA_DIR/pgdata (nothing to install).
DATABASE_URL=
# Folder for the built-in database, the WhatsApp outbox log and linked WhatsApp numbers
DATA_DIR=./apps/api/data
# production turns off the demo login code
NODE_ENV=development
# Server clock for quiet hours
TZ=Asia/Kolkata

# Live WhatsApp for pitch demos (see docs/whatsapp-live-demo.md). Leave empty to keep every message simulated.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any phrase you choose; type the same one into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Optional: an approved template with one body variable, for messages outside WhatsApp's 24-hour window
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
